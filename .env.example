# Never commit real credentials. Copy to .env and fill only what you use.

# --- GitHub sign-in for the dashboard (OAuth App) ---------------------------------
# Create at https://github.com/settings/developers -> OAuth Apps -> New OAuth App.
# Homepage URL: PUBLIC_BASE_URL. Callback URL: PUBLIC_BASE_URL/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo read:user
PUBLIC_BASE_URL=http://localhost:8000
# Long random string; encrypts stored OAuth tokens and signs sessions.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Demo reviewer accounts (username + password, for evaluators without GitHub) ---------
# Comma-separated "username:hash". Generate each hash (prompts for the password, prints
# only the hash):  python -m pr_reviewer.cli_auth   (or: pr-reviewer-hash-password)
# Hash format: pbkdf2_sha256$<iterations>$<salt_b64>$<hash_b64>, iterations >= 600000.
# Demo users cannot browse repositories; they enter owner/repo/number and reviews use the
# server GITHUB_TOKEN / GitHub App credentials.
DEMO_ACCOUNTS=

# --- Server-side GitHub access (webhooks, API and CLI without a signed-in user) ------
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# --- LLM specialists (OpenAI-compatible) --------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
AGENT_TIMEOUT=45
# Findings below this confidence are suppressed (0 keeps everything).
MIN_CONFIDENCE=0

# --- Storage and execution ------------------------------------------------------------
# postgres:// and postgresql:// URLs (as given by Render) are converted automatically.
DATABASE_URL=postgresql+psycopg://reviewer:reviewer@postgres:5432/reviewer
REVIEW_CONCURRENCY=2

# --- Publishing (advisory COMMENT reviews only; never approve or merge) ----------------
# Server permission. Each dashboard/API review must still opt in with publish=true.
PUBLISH_REVIEWS=false
# Also publish reviews triggered by webhooks (requires PUBLISH_REVIEWS=true).
WEBHOOK_AUTO_PUBLISH=false

# Optional second provider for rate limits / exhausted quota (OpenAI-compatible).
# Defaults to Groq's free tier with a model that supports strict JSON-schema output.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
